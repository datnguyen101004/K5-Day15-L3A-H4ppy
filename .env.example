# Chép thành .env rồi điền key của gói Alibaba Cloud Token Plan.
# .env đã có trong .gitignore. Không đưa key vào code hoặc kết quả đánh giá.
# MODEL_PROVIDER=openai dùng giao thức OpenAI-compatible.
MODEL_PROVIDER=openai
MODEL_NAME=qwen3.7-plus
OPENAI_API_BASE=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
API_KEY=
