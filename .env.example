# Chép thành .env rồi điền key của gói Alibaba Cloud Token Plan.
# .env đã có trong .gitignore. Không đưa key vào code hoặc kết quả đánh giá.
# MODEL_PROVIDER=openai dùng giao thức OpenAI-compatible.
MODEL_PROVIDER=openai
MODEL_NAME=qwen3.7-plus
OPENAI_API_BASE=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
API_KEY=
# --- Lớp học tranh tài (classroom/): RAG trên slide ---
# Model embedding dùng cùng OPENAI_API_BASE + key (vd Mistral: OPENAI_API_BASE=https://api.mistral.ai/v1,
# MODEL_NAME=mistral-medium-latest, EMBED_MODEL=mistral-embed — vector 1024 chiều). Để trống: chỉ tìm theo từ khoá.
EMBED_MODEL=
# PostgreSQL có extension pgvector. Để trống: RAG dùng BM25 trong bộ nhớ.
# Chạy nhanh bằng Docker: docker run -d --name lhtt-pg -e POSTGRES_USER=lhtt -e POSTGRES_PASSWORD=<mật khẩu> -e POSTGRES_DB=lhtt -p 127.0.0.1:5433:5432 pgvector/pgvector:pg16
DATABASE_URL=
